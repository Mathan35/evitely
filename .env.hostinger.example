# Invidora — Hostinger production (.env)
# Copy to .env on the server, then: php artisan key:generate
# DB names from hPanel → MySQL (often prefixed u123456789_...)

APP_NAME="Invidora"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://invidora.com

INVITE_ROOT_DOMAIN=invidora.com
INVITE_SUBDOMAINS_ENABLED=false
# Use null until you enable *.invidora.com subdomains:
SESSION_DOMAIN=null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_FROM_HPANEL
DB_USERNAME=CHANGE_ME_FROM_HPANEL
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@invidora.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="Invidora"

BILLING_DRIVER=razorpay
BILLING_CURRENCY=inr

# Owner console at /admin (required — without this, /admin returns 404)
PLATFORM_ADMIN_EMAILS=bmathank555@gmail.com

# Social sign-in — set in Google Cloud / Meta / Apple Developer consoles
# Redirects: https://invidora.com/auth/{google|facebook|apple}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
