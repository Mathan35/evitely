APP_NAME="Invidora"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://invidora.com

# Invite subdomains: https://{slug}.{INVITE_ROOT_DOMAIN}/
# Auto-enabled when APP_URL host is not localhost. Set false to force path-only links.
# INVITE_ROOT_DOMAIN=invidora.com
# INVITE_SUBDOMAINS_ENABLED=true
#
# Production subdomain checklist:
# 1) DNS: wildcard A/AAAA (or CNAME) for *.yourdomain.com → app server
# 2) TLS: certificate covering *.yourdomain.com (and apex)
# 3) INVITE_ROOT_DOMAIN=yourdomain.com  INVITE_SUBDOMAINS_ENABLED=true
# 4) SESSION_DOMAIN=.yourdomain.com  so login/studio cookies work across apex + subdomains
# 5) APP_URL=https://yourdomain.com  (canonical host for non-invite links)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedding_invitation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: null. Production with invite subdomains: .yourdomain.com (leading dot)
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production: Twilio Email (SendGrid). Local default: log.
# 1) Twilio Console → SendGrid → API key + verified sender domain
# 2) MAIL_MAILER=twilio_email  (or failover)
# 3) php artisan queue:work
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@invidora.com"
MAIL_FROM_NAME="${APP_NAME}"
TWILIO_SENDGRID_API_KEY=
# Optional fallback: RESEND_API_KEY=
RESEND_API_KEY=

# Twilio SMS / WhatsApp (Automated / Pro). Free mode needs no keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Prefer real mail in prod (auto-picks twilio_email/resend when keys exist):
# MAIL_MAILER=twilio_email
# QUEUE_CONNECTION=database
# Then: php artisan queue:work
# Cron: * * * * * php artisan schedule:run

# Invite subdomains: https://{slug}.{INVITE_ROOT_DOMAIN}/
# INVITE_ROOT_DOMAIN=yourdomain.com
# INVITE_SUBDOMAINS_ENABLED=true

# Host digests + RSVP auto-reminders
# HOST_DIGEST_ENABLED=true
# HOST_DIGEST_HOUR=8
# RSVP_REMINDERS_DEFAULT_ENABLED=true
# RSVP_REMINDER_DAYS_BEFORE=7

# Owner admin console (/admin) — PLATFORM_ADMIN_EMAILS only (not BILLING_ADMIN_EMAILS)
PLATFORM_ADMIN_EMAILS=bmathank555@gmail.com

# Billing — per-site packs (INR + USD). Dual checkout: India→Razorpay, else→Stripe.
# BILLING_DRIVER=razorpay|stripe|local
BILLING_DRIVER=
BILLING_ALLOW_LOCAL_ACTIVATE=false
BILLING_CURRENCY=inr
BILLING_ADMIN_EMAILS=

# Razorpay (INR / India — UPI, cards, netbanking)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Stripe / Cashier (USD / global)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
CASHIER_CURRENCY=usd
CASHIER_PATH=stripe
# Optional legacy season price IDs (unused for new site packs; price_data is used)
STRIPE_PRICE_PRO_SEASON_6=
STRIPE_PRICE_PRO_SEASON_12=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Invidora"

# Invitation auto-translate (Preferences ? Secondary copy)
# Drivers: google (default, no key), mymemory, deepl
TRANSLATION_DRIVER=google

# TRANSLATION_DEEPL_KEY=

# Optional error monitoring (composer require sentry/sentry-laravel)
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Social sign-in (Google / Facebook) — Laravel Socialite
# Callbacks: {APP_URL}/auth/{google|facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

